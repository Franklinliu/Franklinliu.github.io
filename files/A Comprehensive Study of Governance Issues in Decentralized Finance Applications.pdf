      <dc:format>application/pdf</dc:format>
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="en">A Comprehensive Study of Governance Issues in Decentralized Finance Applications</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="en">-  Software and its engineering  -&gt;  Software creation and management;-  Security and privacy  -&gt;  Trust frameworks;Security requirements;Logic and verification;-  Computer systems organization  -&gt;  Distributed architectures;-  Social and professional topics  -&gt;  Financial crime;Social engineering attacks;-  Information systems  -&gt;  Decision support systems;Enterprise information systems;</rdf:li>
        </rdf:Alt>
      </dc:description>
